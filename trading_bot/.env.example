# Alpaca paper trading API keys.
# Create these in your Alpaca paper trading dashboard, not the live dashboard.
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# This bot refuses to run unless both paper safety flags are true.
PAPER_TRADING=True
ALPACA_PAPER=True

# This beginner version is intentionally locked to SPY.
SYMBOL=SPY

# Live paper strategy.
# Choices: ma_crossover, core_tactical_ma, rebound_reentry_ma, rsi, breakout, buy_and_hold
STRATEGY=ma_crossover

# Use 1Day for the requested 20-day / 50-day strategy.
# You can also set 15Min, which changes the averages to 20-bar / 50-bar.
TIMEFRAME=1Day

# IEX is usually available on free Alpaca data plans. SIP may require a paid data subscription.
DATA_FEED=iex

# Strategy settings.
FAST_MA_PERIOD=20
SLOW_MA_PERIOD=50
CORE_TACTICAL_CORE_FRACTION=0.40
REBOUND_MA_PERIOD=10
REBOUND_RETURN_DAYS=3
REBOUND_MIN_RETURN=0.0
RSI_PERIOD=14
RSI_BUY_LEVEL=30
RSI_SELL_LEVEL=70
BREAKOUT_ENTRY_PERIOD=20
BREAKOUT_EXIT_PERIOD=10
LOOKBACK_DAYS=220

# Risk settings. The bot enforces a maximum of 25%.
BUYING_POWER_FRACTION=0.25
MAX_DAILY_TRADES=1
MAX_POSITION_SIZE_FRACTION=0.25
MIN_ORDER_NOTIONAL=1.00

# Trial paper run settings. Turn this on for the first manual paper run.
TRIAL_MODE=true
TRIAL_MAX_NOTIONAL=25

# Logging.
LOG_LEVEL=INFO
CLIENT_ORDER_ID_PREFIX=pluto-mac
TRADES_CSV=trades.csv

# Optional backtest settings.
BACKTEST_START_DATE=2018-01-01
# BACKTEST_END_DATE=2025-12-31
BACKTEST_INITIAL_CASH=10000
